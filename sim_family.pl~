% ==========================================
% Rules
% ==========================================


% Father
father(X, Y) :-
    parent(X, Y),
    male(X).


% Mother
mother(X, Y) :-
    parent(X, Y),
    female(X).


% Son
son(X, Y) :-
    parent(Y, X),
    male(X).


% Daughter
daughter(X, Y) :-
    parent(Y, X),
    female(X).


% Brother
brother(X, Y) :-
    parent(P, X),
    parent(P, Y),
    male(X),
    X \= Y.


% Sister
sister(X, Y) :-
    parent(P, X),
    parent(P, Y),
    female(X),
    X \= Y.


% Grandfather
grandfather(X, Z) :-
    parent(X, Y),
    parent(Y, Z),
    male(X).


% Aunt
aunt(X, Y) :-
    sister(X, P),
    parent(P, Y).


% Uncle
uncle(X, Y) :-
    brother(X, P),
    parent(P, Y).


% Cousin
cousin(X, Y) :-
    parent(P1, X),
    parent(P2, Y),
    parent(G, P1),
    parent(G, P2),
    P1 \= P2,
    X \= Y.


% Ancestor
ancestor(X, Y) :-
    parent(X, Y).

ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).


